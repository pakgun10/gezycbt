{
  "name": "gezycbt",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun run test && bun run build",
    "bootstrap:admin": "bun --filter '@gezycbt/api' bootstrap:admin",
    "typecheck": "bun --filter '@gezycbt/*' typecheck",
    "lint": "bun --filter '@gezycbt/*' lint",
    "test": "bun --filter '@gezycbt/*' test",
    "db:test:up": "docker compose -f ops/docker-compose.test.yml up -d --wait",
    "db:test:down": "docker compose -f ops/docker-compose.test.yml down --volumes",
    "test:integration": "TEST_DATABASE_URL=mariadb://gezycbt_test:gezycbt_test@127.0.0.1:33067/gezycbt_test bun --filter '@gezycbt/database' test:integration",
    "build": "bun --filter '@gezycbt/*' build"
  },
  "engines": { "bun": "1.4.2" }
}
