# Use a disposable MariaDB database. Do not commit real credentials.
SPIKE_DATABASE_URL=mariadb://user:password@127.0.0.1:3306/gezy_spike
SPIKE_ADAPTER=mariadb
SPIKE_POOL_MAX=4
SPIKE_CONNECTION_TIMEOUT_SECONDS=5

# Optional: test a Unix socket connection in a separate run.
# SPIKE_SOCKET_PATH=/var/run/mysqld/mysqld.sock
