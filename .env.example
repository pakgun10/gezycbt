# Copy to .env.local for local development. Never commit real credentials.
APP_ENV=development
APP_RELEASE=local
APP_ORIGIN=http://127.0.0.1:3000
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=debug

# Matches ops/docker-compose.dev.yml.
GEZYCBT_DATABASE_URL=mariadb://gezycbt_dev:gezycbt_dev@127.0.0.1:33068/gezycbt_dev

# Required in production; keep private and rotate through the deployment secret store.
# GEZYCBT_ACCESS_CODE_HMAC_SECRET=replace-with-at-least-32-random-characters

# Optional protected media directory (must remain outside the webroot).
# GEZYCBT_MEDIA_ROOT=/var/lib/gezycbt/media

# Optional; migration defaults to 30 seconds.
# MIGRATION_LOCK_TIMEOUT_SECONDS=30
