[Unit]
Description=GezyCBT API
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=gezycbt
Group=gezycbt
WorkingDirectory=/home/ubuntu/gezycbt/current
EnvironmentFile=/etc/gezycbt/gezycbt.env
ExecStart=/usr/local/bin/bun --cwd /home/ubuntu/gezycbt/current/apps/api src/index.ts
Restart=on-failure
RestartSec=3s
TimeoutStopSec=30s
KillSignal=SIGTERM
LimitNOFILE=65536
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ReadWritePaths=/var/lib/gezycbt /var/log/gezycbt

[Install]
WantedBy=multi-user.target
