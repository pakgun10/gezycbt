[Unit]
Description=GezyCBT bounded housekeeping
After=mariadb.service

[Service]
Type=oneshot
User=gezycbt
Group=gezycbt
WorkingDirectory=/home/ubuntu/gezycbt/current
EnvironmentFile=/etc/gezycbt/gezycbt.env
ExecStart=/usr/bin/flock -n /run/lock/gezycbt-housekeeping.lock /home/ubuntu/gezycbt/current/ops/bin/gezycbt-job housekeeping
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
