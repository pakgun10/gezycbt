[Unit]
Description=GezyCBT exam timeout finalizer
After=mariadb.service

[Service]
Type=oneshot
User=gezycbt
Group=gezycbt
WorkingDirectory=/opt/gezycbt/current
EnvironmentFile=/etc/gezycbt/gezycbt.env
ExecStart=/usr/bin/flock -n /run/lock/gezycbt-finalize.lock /opt/gezycbt/current/ops/bin/gezycbt-job finalize
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
