[Unit]
Description=GezyCBT bounded export worker
After=mariadb.service

[Service]
Type=oneshot
User=gezycbt
Group=gezycbt
WorkingDirectory=/home/ubuntu/gezycbt/current
EnvironmentFile=/etc/gezycbt/gezycbt.env
ExecStart=/usr/bin/flock -n /run/lock/gezycbt-export-worker.lock /home/ubuntu/gezycbt/current/ops/bin/gezycbt-job export
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ReadWritePaths=/var/lib/gezycbt
