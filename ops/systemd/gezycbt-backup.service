[Unit]
Description=GezyCBT encrypted offsite backup
After=mariadb.service

[Service]
Type=oneshot
User=gezycbt
Group=gezycbt
WorkingDirectory=/home/ubuntu/gezycbt/current
EnvironmentFile=/etc/gezycbt/gezycbt.env
ExecStart=/usr/bin/flock -n /run/lock/gezycbt-backup.lock /home/ubuntu/gezycbt/current/ops/backup/backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ReadWritePaths=/var/lib/gezycbt /var/backups/gezycbt
